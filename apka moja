.ai-sug:active{background:var(--or2);border-color:var(--or3);color:var(--or);}
</style>



<!-- AI Panel -->
<div class="ai-panel" id="ai-panel">
  <div class="ai-header">
    <div class="ai-header-left">
      <div class="ai-avatar">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/></svg>
      </div>
      <div>
        <div class="ai-title">JL Assistant</div>
        <div class="ai-sub">POWERED BY CLAUDE</div>
      </div>
    </div>
    <button class="ai-close" onclick="closeAI()">✕</button>
  </div>

  <div class="ai-messages" id="ai-messages"></div>

  <div class="ai-suggestions" id="ai-suggestions">
    <button class="ai-sug" onclick="useSug(this)">Jak zwiększyć dochody?</button>
    <button class="ai-sug" onclick="useSug(this)">Pomysł na biznes</button>
    <button class="ai-sug" onclick="useSug(this)">Jak pozyskać klientów?</button>
    <button class="ai-sug" onclick="useSug(this)">Motywacja na dziś</button>
    <button class="ai-sug" onclick="useSug(this)">Jak oszczędzać?</button>
  </div>

  <div class="ai-input-row">
    <textarea class="ai-input" id="ai-input" placeholder="Napisz do asystenta..." rows="1"
      onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendAI();}"></textarea>
    <button class="ai-send" id="ai-send-btn" onclick="sendAI()">
      <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
    </button>
  </div>
</div>

<script>
const AI_SYSTEM = `Jesteś osobistym asystentem biznesowym Jacka. Jacek jest przedsiębiorcą który prowadzi kilka biznesów: iPhone flipping (kupno/sprzedaż telefonów), sprzedaż ebooków, high-ticket sales, oraz pracuje w Perfectto. Używa aplikacji JL Fortress do zarządzania finansami, klientami, zadaniami i grafikiem. Odpowiadaj krótko, konkretnie i po polsku. Jesteś pomocny, bezpośredni i motywujący. Mów do Jacka po imieniu.`;

let aiHistory = [];
let aiTyping = false;

function openAI() {
  document.getElementById('ai-panel').classList.add('open');
  if(aiHistory.length===0) {
    addBotMsg('Siema Jacek! 👋 Jestem Twoim asystentem. Mogę pomóc z biznesem, finansami, motywacją — pytaj o co chcesz!');
  }
  setTimeout(()=>document.getElementById('ai-input').focus(),400);
}

function closeAI() {
  document.getElementById('ai-panel').classList.remove('open');
}

function useSug(el) {
  document.getElementById('ai-input').value = el.textContent;
  sendAI();
}

function getTime() {
  return new Date().toLocaleTimeString('pl-PL',{hour:'2-digit',minute:'2-digit'});
}

function addUserMsg(text) {
  const msgs = document.getElementById('ai-messages');
  msgs.innerHTML += `<div class="ai-msg user"><div class="ai-bubble">${escHtml(text)}</div><div class="ai-msg-time">${getTime()}</div></div>`;
  scrollAI();
}

function addBotMsg(text) {
  const msgs = document.getElementById('ai-messages');
  msgs.innerHTML += `<div class="ai-msg bot"><div class="ai-bubble">${escHtml(text)}</div><div class="ai-msg-time">${getTime()}</div></div>`;
  scrollAI();
}

function showTyping() {
  const msgs = document.getElementById('ai-messages');
  msgs.innerHTML += `<div class="ai-msg bot" id="ai-typing-row"><div class="ai-typing"><span></span><span></span><span></span></div></div>`;
  scrollAI();
}

function hideTyping() {
  const t = document.getElementById('ai-typing-row');
  if(t) t.remove();
}

function scrollAI() {
  const msgs = document.getElementById('ai-messages');
  setTimeout(()=>msgs.scrollTop=msgs.scrollHeight,50);
}

function escHtml(t) {
  return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>');
}

async function sendAI() {
  if(aiTyping) return;
  const inp = document.getElementById('ai-input');
  const text = inp.value.trim();
  if(!text) return;
  inp.value='';
  inp.style.height='auto';

  addUserMsg(text);
  aiHistory.push({role:'user',content:text});

  aiTyping=true;
  document.getElementById('ai-send-btn').disabled=true;
  showTyping();

  // build context from app data
  const at = getAllTotals();
  const mt = getMonthTotals(getCurMonth());
  const ctx = `Dane Jacka: łączny dochód ${fmt(at.inc)} zł, wydatki ${fmt(at.exp)} zł, netto ${fmt(at.net)} zł. Ten miesiąc: in ${fmt(mt.inc)} zł, out ${fmt(mt.exp)} zł. Zadania do zrobienia: ${DB.tasks.filter(t=>t.status!=='done').length}. Klienci: ${DB.contacts.length}.`;

  try {
    const res = await fetch('https://api.anthropic.com/v1/messages',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        model:'claude-sonnet-4-20250514',
        max_tokens:1000,
        system: AI_SYSTEM + ' ' + ctx,
        messages: aiHistory.slice(-10)
      })
    });
    const data = await res.json();
    hideTyping();
    const reply = data.content?.[0]?.text || 'Przepraszam, coś poszło nie tak.';
    aiHistory.push({role:'assistant',content:reply});
    addBotMsg(reply);
  } catch(e) {
    hideTyping();
    addBotMsg('Błąd połączenia. Sprawdź internet i spróbuj ponownie.');
  }

  aiTyping=false;
  document.getElementById('ai-send-btn').disabled=false;
}

// auto-resize textarea
document.getElementById('ai-input').addEventListener('input',function(){
  this.style.height='auto';
  this.style.height=Math.min(this.scrollHeight,100)+'px';
});
</script>
