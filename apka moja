  `);
}
function saveContact() {
  const name = document.getElementById('c-name').value.trim();
  if(!name) return;
  DB.contacts.push({
    id:uid(), name,
    type: document.getElementById('c-type').value,
    status: document.getElementById('c-status').value,
    phone: document.getElementById('c-phone').value.trim(),
    email: document.getElementById('c-email').value.trim(),
    note: document.getElementById('c-note').value.trim(),
    date: today
  });
  saveData(); closeModal(); renderKlienci();
}

// ── GRAFIK ──
function renderGrafik() {
  const MONTHS_SHORT = ['STY','LUT','MAR','KWI','MAJ','CZE','LIP','SIE','WRZ','PAŹ','LIS','GRU'];
  const up = [...DB.meetings].sort((a,b)=>a.date.localeCompare(b.date)).filter(m=>m.date>=today);
  const past = [...DB.meetings].sort((a,b)=>b.date.localeCompare(a.date)).filter(m=>m.date<today);

  const mtgRow = (m, faded=false) => `
    <div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #121212;${faded?'opacity:0.4;':''}">
      <div class="cal-date-box" style="width:36px;height:36px;border-radius:9px;">
        <div class="cal-dd" style="font-size:14px;">${m.date.split('-')[2]}</div>
        <div class="cal-mm">${MONTHS_SHORT[parseInt(m.date.split('-')[1])-1]}</div>
      </div>
      <div style="flex:1;min-width:0;">
        <div class="row-title" style="font-size:12px;">${m.title}</div>
        <div class="row-sub">${m.time?m.time+' • ':''}${m.type==='business'?'Biznesowe':m.type==='social'?'Towarzyskie':'Mieszane'}</div>
      </div>
      <button class="del-btn" onclick="delMeeting(${m.id})" style="font-size:15px;">✕</button>
    </div>`;

  document.getElementById('grafik-content').innerHTML = `
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:2px;">
      <div class="page-title">Grafik</div>
      <span style="font-size:11px;color:var(--or);font-weight:800;">${up.length} nadchodzących</span>
    </div>
    <div class="or-line" style="margin-bottom:10px;"></div>

    <div class="stat-grid" style="margin-bottom:10px;">
      <div class="stat-card"><div class="stat-card-accent"></div><div class="stat-label">NADCHODZĄCE</div><div class="stat-val orange">${up.length}</div></div>
      <div class="stat-card"><div class="stat-card-accent"></div><div class="stat-label">BIZNESOWE</div><div class="stat-val">${DB.meetings.filter(m=>m.type==='business').length}</div></div>
      <div class="stat-card"><div class="stat-card-accent"></div><div class="stat-label">TOWARZYSKIE</div><div class="stat-val">${DB.meetings.filter(m=>m.type==='social').length}</div></div>
      <div class="stat-card"><div class="stat-card-accent"></div><div class="stat-label">RAZEM</div><div class="stat-val">${DB.meetings.length}</div></div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px;">
      <div>
        <div style="font-size:9px;color:var(--txt3);letter-spacing:2px;font-weight:700;margin-bottom:6px;">NADCHODZĄCE</div>
        <div style="overflow-y:auto;-webkit-overflow-scrolling:touch;background:var(--bg2);border:1px solid var(--brd);border-radius:14px;padding:2px 10px;max-height:200px;">
          ${up.length===0?`<div class="empty" style="font-size:11px;padding:16px 0;">Brak</div>`:up.map(m=>mtgRow(m,false)).join('')}
        </div>
      </div>
      <div>
        <div style="font-size:9px;color:var(--txt3);letter-spacing:2px;font-weight:700;margin-bottom:6px;">MINIONE</div>
        <div style="overflow-y:auto;-webkit-overflow-scrolling:touch;background:var(--bg2);border:1px solid var(--brd);border-radius:14px;padding:2px 10px;max-height:200px;">
          ${past.length===0?`<div class="empty" style="font-size:11px;padding:16px 0;">Brak</div>`:past.map(m=>mtgRow(m,true)).join('')}
        </div>
      </div>
    </div>

    <button class="or-btn" style="padding:13px;font-size:13px;" onclick="openAddMeeting()">+ Nowe spotkanie</button>
  `;
}

function delMeeting(id) {
  DB.meetings = DB.meetings.filter(m=>m.id!==id);
  saveData(); renderGrafik();
}
function openAddMeeting() {
  showModal(`
    <div class="modal-handle"></div>
    <div class="modal-title">📅 Nowe spotkanie</div>
    <div class="field-label">TEMAT</div>
    <input class="field" id="m-title" placeholder="O czym spotkanie?">
    <div class="field-label">TYP</div>
    <select class="field" id="m-type">
      <option value="business">💼 Biznesowe</option>
      <option value="social">🤝 Towarzyskie</option>
      <option value="mixed">🔀 Mieszane</option>
    </select>
    <div class="field-label">DATA</div>
    <input class="field" id="m-date" type="date" value="${today}">
    <div class="field-label">GODZINA</div>
    <input class="field" id="m-time" type="time">
    <div class="field-label">MIEJSCE (OPCJONALNIE)</div>
    <input class="field" id="m-location" placeholder="Gdzie?">
    <div class="field-label">NOTATKA</div>
    <textarea class="field" id="m-note" rows="2" placeholder="Dodatkowe info..."></textarea>
    <div class="modal-btns">
      <button class="cancel-btn" onclick="closeModal()">Anuluj</button>
      <button class="save-btn" onclick="saveMeeting()">Dodaj</button>
    </div>
  `);
}
function saveMeeting() {
  const title = document.getElementById('m-title').value.trim();
  if(!title) return;
  DB.meetings.push({
    id:uid(), title,
    type: document.getElementById('m-type').value,
    date: document.getElementById('m-date').value||today,
    time: document.getElementById('m-time').value,
    location: document.getElementById('m-location').value.trim(),
    note: document.getElementById('m-note').value.trim()
  });
  saveData(); closeModal(); renderGrafik();
}

// ── MODAL ──
function showModal(html) {
  const c = document.getElementById('modal-container');
  c.innerHTML = `<div class="modal-backdrop" id="modal-backdrop"><div class="modal" onclick="event.stopPropagation()">${html}</div></div>`;
  document.getElementById('modal-backdrop').addEventListener('click', function(e){ if(e.target===this) closeModal(); });
  setTimeout(()=>{ const f=c.querySelector('input,select,textarea'); if(f) f.focus(); },100);
}
function closeModal() {
  document.getElementById('modal-container').innerHTML='';
}

// ── INTRO ──
document.getElementById('enter-btn').addEventListener('click', function() {
  this.textContent = 'Ładuję...';
  setTimeout(() => {
    document.getElementById('intro').style.display='none';
    document.getElementById('app').style.display='flex';
    setTopbarDate();
    renderHome();
    document.getElementById('ai-topbar-btn').style.display='flex';
  }, 400);
});

// ── INIT ──
setTopbarDate();
</script>

<!-- AI CHAT -->
<style>
.ai-panel{position:fixed;inset:0;z-index:9998;max-width:480px;margin:0 auto;display:flex;flex-direction:column;background:#000;transform:translateY(100%);transition:transform 0.35s cubic-bezier(0.22,1,0.36,1);}
.ai-panel.open{transform:translateY(0);}

.ai-header{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #1a1a1a;flex-shrink:0;}
