.ai-typing{display:flex;gap:4px;align-items:center;padding:12px 14px;background:#111;border:1px solid #1e1e1e;border-radius:16px;border-bottom-left-radius:4px;width:fit-content;}
.ai-typing span{width:6px;height:6px;border-radius:50%;background:#444;animation:typingDot 1.2s infinite;}
.ai-typing span:nth-child(2){animation-delay:0.2s;}
.ai-typing span:nth-child(3){animation-delay:0.4s;}
@keyframes typingDot{0%,60%,100%{transform:translateY(0);background:#444;}30%{transform:translateY(-5px);background:var(--or);}}

.ai-input-row{display:flex;gap:8px;padding:12px 16px;border-top:1px solid #1a1a1a;flex-shrink:0;padding-bottom:calc(12px + env(safe-area-inset-bottom,0));}
.ai-input{flex:1;background:#111;border:1px solid #252525;color:#fff;padding:11px 14px;border-radius:12px;outline:none;font-size:15px;font-family:inherit;resize:none;max-height:100px;transition:border-color 0.2s;}
.ai-input:focus{border-color:var(--or);}
.ai-input::placeholder{color:#2a2a2a;}
.ai-send{width:44px;height:44px;border-radius:12px;background:var(--or);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:opacity 0.15s,transform 0.1s;}
.ai-send:active{opacity:0.8;transform:scale(0.95);}
.ai-send svg{width:18px;height:18px;stroke:#000;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;}
