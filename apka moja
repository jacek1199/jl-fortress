.ai-close{background:none;border:none;color:#444;font-size:22px;cursor:pointer;padding:4px 8px;line-height:1;}
.ai-close:hover{color:#fff;}

.ai-messages{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:16px;display:flex;flex-direction:column;gap:10px;}

.ai-msg{display:flex;flex-direction:column;max-width:85%;}
.ai-msg.user{align-self:flex-end;align-items:flex-end;}
